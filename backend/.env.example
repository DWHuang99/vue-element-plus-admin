# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database configuration
DATABASE_URL=postgres://scaffold:scaffold_dev@localhost:5432/scaffold_dev?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=text

# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_IP_HOUR=10
RATE_LIMIT_LOGIN_IP_15MIN=10
RATE_LIMIT_LOGIN_USER_15MIN=5

# CORS configuration (comma-separated; empty = allow all, dev only)
CORS_ALLOWED_ORIGINS=
