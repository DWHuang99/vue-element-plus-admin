DEPARTMENT_POSTGRES_DB=department
DEPARTMENT_POSTGRES_USER=department_app
DEPARTMENT_POSTGRES_PASSWORD=replace-with-department-database-password
DEPARTMENT_POSTGRES_PORT=5433

GATEWAY_PORT=8080
IAM_API_PORT=8081
DEPARTMENT_API_PORT=8082
SERVICE_GRPC_TIMEOUT_MS=3000

JWT_KEY_ID=key-2026-08
JWT_ISSUER=vue-element-plus-admin
JWT_AUDIENCE=vue-element-plus-admin-api
JWT_ACCESS_TOKEN_EXPIRE_MS=900000
JWT_REFRESH_TOKEN_EXPIRE_MS=604800000

REDIS_PORT=6379
REDIS_PASSWORD=
