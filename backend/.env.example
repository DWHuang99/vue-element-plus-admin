OIDC_FRONTEND_REDIRECT_URL=http://localhost:4000/#/login

GATEWAY_DIAL_TIMEOUT_MS=1000
GATEWAY_RESPONSE_HEADER_TIMEOUT_MS=3000
GATEWAY_READ_HEADER_TIMEOUT_MS=2000
